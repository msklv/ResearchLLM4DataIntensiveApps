# The embedding service model:
# Available options:
# - `Qwen/Qwen3-Embedding-0.6B` (requires 25GB RAM/vRAM to load)
# - `BAAI/bge-m3` (requires 21GB RAM/vRAM to load)
# https://huggingface.co/docs/text-embeddings-inference/supported_models
TEI_MODEL=Qwen/Qwen3-Embedding-0.6B

# The embedding service port:

# The port used to expose the TEI service to the host machine,
# allowing EXTERNAL access to the service running inside the Docker container.
TEI_PORT=9090

# Заготовка для Apple Silicon
#TEI_HOST=host.docker.internal


# Ollama
OLLAMA_PORT=11434
OLLAMA_LOAD_TIMEOUT=10m
OLLAMA_MODEL=qwen3.5:0.8b