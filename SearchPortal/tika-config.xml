<?xml version="1.0" encoding="UTF-8"?>
<tika-config xmlns="http://tika.apache.org/1.0"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://tika.apache.org/1.0 tika-config.xsd">

  <!-- ===================================================== -->
  <!-- 1.  Ограничения по размеру и времени обработки          -->
  <!-- ===================================================== -->
  <properties>
    <!-- Максимальный размер входного потока, который Tika будет принимать.
         По‑умолчанию 100 МБ; здесь ставим 50 МБ – достаточно для большинства
         «корпоративных» документов, но не позволяет «заполнять» контейнер. -->
    <property name="tika.config.parser.maxLength">50000000</property>

    <!-- Таймаут парсинга (мс). Если парсер «запутался», запрос будет
         завершён принудительно. -->
    <property name="tika.parser.timeout">120000</property>
  </properties>

  <!-- ===================================================== -->
  <!-- 2.  Стандартные парсеры (PDF, Office, HTML, …)        -->
  <!-- ===================================================== -->
  <parser>
    <!-- Указываем набор‑пакетов, из которых Tika будет искать парсеры.
         Это «большой набор», покрывающий почти все форматы. -->
    <parser class="org.apache.tika.parser.AutoDetectParser"/>
  </parser>

  <!-- ===================================================== -->
  <!-- 3.  OCR – Tesseract (для сканов и изображений)        -->
  <!-- ===================================================== -->
  <ocr>
    <!-- Путь к исполняемому файлу Tesseract внутри контейнера.
         В официальном образе он лежит в /usr/bin/tesseract. -->
    <tesseract executable="/usr/bin/tesseract"/>

    <!-- Языковые пакеты, которые будут использоваться.
         Русский и английский – самые распространённые. -->
    <languages>
      <language>rus</language>
      <language>eng</language>
    </languages>

    <!-- DPI, который будет передаваться Tesseract (чем выше, тем лучше
         качество, но тем больше RAM). 300 dpi – «golden‑standard». -->
    <dpi>300</dpi>

    <!-- Если нужно, можно задать пользовательский «config» файл Tesseract.
         Оставляем пустым → берётся дефолтный. -->
    <config></config>

    <!-- Ограничиваем количество страниц, которые будут обработаны OCR‑ом,
         чтобы не «перегрузить» сервер при огромных PDF‑сканах. -->
    <maxPages>50</maxPages>
  </ocr>

  <!-- ===================================================== -->
  <!-- 4.  Вывод метаданных в JSON (удобно для последующего -->
  <!--     индексирования в Qdrant)                           -->
  <!-- ===================================================== -->
  <metadata>
    <output-format>json</output-format>
    <!-- Записывать ВСЕ метаданные (не только базовые). -->
    <include-all-metadata>true</include-all-metadata>
  </metadata>

  <!-- ===================================================== -->
  <!-- 5.  Языковый детектор (для возможности последующей   -->
  <!--     фильтрации/маршаллирования)                      -->
  <!-- ===================================================== -->
  <language-detector>
    <!-- Авто‑выбор модели (small = быстрый, large = точный). -->
    <model class="org.apache.tika.language.detect.optimaize.OptimaizeLangDetector"/>
  </language-detector>

  <!-- ===================================================== -->
  <!-- 6.  Логирование (по желанию)                         -->
  <!-- ===================================================== -->
  <log>
    <!-- Уровень INFO – информативно, но не «мусорит». -->
    <level>INFO</level>
    <!-- Путь к файлу журнала (внутри контейнера). -->
    <file>/tmp/tika.log</file>
    <!-- Включить «trace» только при отладке. -->
    <trace>false</trace>
  </log>

</tika-config>
